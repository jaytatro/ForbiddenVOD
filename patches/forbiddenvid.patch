+package com.nuvio.tv.ui.screens.kids
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.nuvio.tv.core.kids.KidsCatalogService
+import com.nuvio.tv.core.kids.KidsProfileStore
+import com.nuvio.tv.domain.model.MetaPreview
+import dagger.hilt.android.lifecycle.HiltViewModel
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import javax.inject.Inject
+
+data class KidsRow(
+    val key: String,
+    val title: String,
+    val items: List<MetaPreview> = emptyList(),
+    val loading: Boolean = true
+)
+
+data class KidsGenre(val id: Int?, val label: String)
+
+data class KidsBrowseState(
+    val genre: Int? = null,
+    val items: List<MetaPreview> = emptyList(),
+    val loading: Boolean = false,
+    val page: Int = 0,
+    val canLoadMore: Boolean = true
+)
+
+@HiltViewModel
+class KidsViewModel @Inject constructor(
+    private val kidsProfileStore: KidsProfileStore,
+    private val service: KidsCatalogService
+) : ViewModel() {
+
+    /** null until the saved profile has been read. */
+    private val _isKids = MutableStateFlow<Boolean?>(null)
+    val isKids: StateFlow<Boolean?> = _isKids.asStateFlow()
+
+    val hasRatingsSource: Boolean get() = service.hasRatingsSource
+
+    private val _homeRows = MutableStateFlow<List<KidsRow>>(emptyList())
+    val homeRows: StateFlow<List<KidsRow>> = _homeRows.asStateFlow()
+
+    private val _browse = MutableStateFlow(KidsBrowseState())
+    val browse: StateFlow<KidsBrowseState> = _browse.asStateFlow()
+    private var browseJob: Job? = null
+    private var browseType: String = "movie"
+
+    init {
+        viewModelScope.launch {
+            _isKids.value = kidsProfileStore.isKidsProfileActiveNow()
+            kidsProfileStore.isKidsProfileActive.collect {
+                _isKids.value = kidsProfileStore.isKidsProfileActiveNow()
+            }
+        }
+    }
+
+    fun loadHome() {
+        if (_homeRows.value.isNotEmpty()) return
+        val defs = listOf(
+            Triple("m_pop", "Popular Kids Movies", "movie" to null),
+            Triple("m_anim", "Animated Movies", "movie" to 16),
+            Triple("m_family", "Family Movies", "movie" to 10751),
+            Triple("m_adv", "Adventure Movies", "movie" to 12),
+            Triple("t_kids", "Kids TV", "series" to 10762),
+            Triple("t_anim", "Animated Series", "series" to 16),
+            Triple("t_family", "Family TV", "series" to 10751),
+            Triple("m_comedy", "Comedy Movies", "movie" to 35)
+        )
+        _homeRows.value = defs.map { (key, title, _) -> KidsRow(key, title) }
+        defs.forEach { (key, _, spec) ->
+            viewModelScope.launch {
+                val (type, genre) = spec
+                // Show the first page as soon as it's ready, then add a second page.
+                for (page in 1..2) {
+                    val pageItems = if (type == "movie") service.movies(genre, page) else service.tv(genre, page)
+                    _homeRows.update { rows ->
+                        rows.map {
+                            if (it.key == key) {
+                                it.copy(items = (it.items + pageItems).distinctBy { item -> item.id }, loading = page < 2)
+                            } else {
+                                it
+                            }
+                        }.filterNot { !it.loading && it.items.isEmpty() }
+                    }
+                }
+            }
+        }
+    }
+
+    fun startBrowse(type: String, genre: Int?) {
+        if (browseType == type && _browse.value.genre == genre && _browse.value.page > 0) return
+        browseType = type
+        browseJob?.cancel()
+        _browse.value = KidsBrowseState(genre = genre)
+        loadMore()
+    }
+
+    fun loadMore() {
+        val state = _browse.value
+        if (state.loading || !state.canLoadMore) return
+        _browse.update { it.copy(loading = true) }
+        browseJob = viewModelScope.launch {
+            val first = state.page + 1
+            val pages = (first..first + 1).map { page ->
+                async { if (browseType == "movie") service.movies(state.genre, page) else service.tv(state.genre, page) }
+            }.awaitAll()
+            val newItems = pages.flatten()
+            _browse.update {
+                it.copy(
+                    items = (it.items + newItems).distinctBy { item -> item.id },
+                    loading = false,
+                    page = first + 1,
+                    canLoadMore = newItems.isNotEmpty() && first + 1 < 30
+                )
+            }
+        }
+    }
+
+    companion object {
+        val MOVIE_GENRES = listOf(
+            KidsGenre(null, "All"), KidsGenre(16, "Animation"), KidsGenre(10751, "Family"),
+            KidsGenre(12, "Adventure"), KidsGenre(35, "Comedy"), KidsGenre(14, "Fantasy"),
+            KidsGenre(10402, "Music"), KidsGenre(878, "Sci-Fi")
+        )
+        val TV_GENRES = listOf(
+            KidsGenre(null, "All"), KidsGenre(10762, "Kids"), KidsGenre(16, "Animation"),
+            KidsGenre(10751, "Family"), KidsGenre(35, "Comedy"), KidsGenre(10765, "Sci-Fi & Fantasy")
+        )
+    }
+}
