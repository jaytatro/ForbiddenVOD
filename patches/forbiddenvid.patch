@@ -0,0 +1,21 @@
+package com.nuvio.tv.core.kids
+
+import com.nuvio.tv.domain.model.Stream
+
+/**
+ * Forbidden Vid stream cleanup:
+ *  - peer-to-peer (torrent-only) streams are hidden;
+ *  - debrid streams that aren't cached yet are hidden. Addons such as AIOStreams / Torrentio play a
+ *    "Torrent is being downloaded to debrid..." placeholder video for those instead of the movie.
+ */
+object StreamCleanup {
+    private val uncachedMarkers = Regex(
+        "(?i)(⏳|\\buncached\\b|\\bnot\\s+cached\\b|\\[[A-Z]{2,4}\\s*download\\]|download(ing)?\\s+to\\s+debrid|\\[[A-Z]{2,4}\\s*⬇)"
+    )
+
+    fun keep(stream: Stream): Boolean {
+        if (stream.isTorrent()) return false
+        val text = listOfNotNull(stream.name, stream.title, stream.description).joinToString(" ")
+        return !uncachedMarkers.containsMatchIn(text)
+    }
+}
