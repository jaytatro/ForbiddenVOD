diff --git a/app/src/main/java/com/nuvio/tv/core/kids/KidsCatalogService.kt b/app/src/main/java/com/nuvio/tv/core/kids/KidsCatalogService.kt
new file mode 100644
index 000000000..bcb2d13e5
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/core/kids/KidsCatalogService.kt
@@ -0,0 +1,133 @@
+package com.nuvio.tv.core.kids
+
+import android.content.Context
+import android.util.Log
+import com.nuvio.tv.BuildConfig
+import com.nuvio.tv.data.remote.api.TmdbApi
+import com.nuvio.tv.data.remote.api.TmdbDiscoverResult
+import com.nuvio.tv.domain.model.ContentType
+import com.nuvio.tv.domain.model.MetaPreview
+import com.nuvio.tv.domain.model.PosterShape
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import java.util.concurrent.ConcurrentHashMap
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Forbidden Vid kids-only catalogs, built straight from TMDB:
+ * movies rated PG / PG-13 and shows rated TV-Y / TV-Y7 / TV-G / TV-PG (US ratings).
+ * Every title's rating is checked again before it is shown.
+ */
+@Singleton
+class KidsCatalogService @Inject constructor(
+    @ApplicationContext context: Context,
+    private val tmdbApi: TmdbApi,
+    private val kidsContentFilter: KidsContentFilter
+) {
+    private val prefs = context.getSharedPreferences("fv_kids_catalog", Context.MODE_PRIVATE)
+    private val memory = ConcurrentHashMap<String, String>()
+    private val permits = Semaphore(12)
+
+    val hasRatingsSource: Boolean get() = BuildConfig.TMDB_API_KEY.isNotBlank()
+
+    suspend fun movies(genreId: Int?, page: Int): List<MetaPreview> {
+        val key = BuildConfig.TMDB_API_KEY.takeIf { it.isNotBlank() } ?: return emptyList()
+        val results = runCatching {
+            tmdbApi.discoverKidsMovies(apiKey = key, withGenres = genreId?.toString(), page = page).body()?.results
+        }.getOrNull().orEmpty()
+        return verified(results, isTv = false, key = key)
+    }
+
+    suspend fun tv(genreId: Int?, page: Int): List<MetaPreview> {
+        val key = BuildConfig.TMDB_API_KEY.takeIf { it.isNotBlank() } ?: return emptyList()
+        val results = runCatching {
+            tmdbApi.discoverKidsTv(apiKey = key, withGenres = genreId?.toString(), page = page).body()?.results
+        }.getOrNull().orEmpty()
+        return verified(results, isTv = true, key = key)
+    }
+
+    private suspend fun verified(results: List<TmdbDiscoverResult>, isTv: Boolean, key: String): List<MetaPreview> =
+        coroutineScope {
+            results.map { result ->
+                async {
+                    permits.withPermit {
+                        try {
+                            val rating = usRating(result.id, isTv, key) ?: return@withPermit null
+                            if (rating !in KidsContentFilter.ALLOWED) return@withPermit null
+                            val imdb = imdbId(result.id, isTv, key)
+                            toPreview(result, isTv, imdb, rating)
+                        } catch (e: CancellationException) {
+                            throw e
+                        } catch (e: Exception) {
+                            Log.w("KidsCatalog", "Skipping ${result.id}: ${e.message}")
+                            null
+                        }
+                    }
+                }
+            }.awaitAll().filterNotNull()
+        }
+
+    /** US certification for a TMDB title (cached). Null when unknown. */
+    private suspend fun usRating(tmdbId: Int, isTv: Boolean, key: String): String? {
+        val cacheKey = (if (isTv) "tvr:" else "mvr:") + tmdbId
+        cached(cacheKey)?.let { return it.ifEmpty { null } }
+        val rating = if (isTv) {
+            tmdbApi.getTvContentRatings(tmdbId, key).body()?.results.orEmpty()
+                .firstOrNull { it.iso31661 == "US" }?.rating
+        } else {
+            tmdbApi.getMovieReleaseDates(tmdbId, key).body()?.results.orEmpty()
+                .firstOrNull { it.iso31661 == "US" }?.releaseDates.orEmpty()
+                .mapNotNull { it.certification?.takeIf(String::isNotBlank) }
+                .firstOrNull()
+        }?.let(KidsContentFilter::normalize).orEmpty()
+        store(cacheKey, rating)
+        return rating.ifEmpty { null }
+    }
+
+    private suspend fun imdbId(tmdbId: Int, isTv: Boolean, key: String): String? {
+        val cacheKey = (if (isTv) "tvi:" else "mvi:") + tmdbId
+        cached(cacheKey)?.let { return it.ifEmpty { null } }
+        val imdb = (if (isTv) tmdbApi.getTvExternalIds(tmdbId, key) else tmdbApi.getMovieExternalIds(tmdbId, key))
+            .body()?.imdbId?.takeIf { it.startsWith("tt") }.orEmpty()
+        store(cacheKey, imdb)
+        return imdb.ifEmpty { null }
+    }
+
+    private fun cached(key: String): String? = memory[key] ?: prefs.getString(key, null)?.also { memory[key] = it }
+
+    private fun store(key: String, value: String) {
+        memory[key] = value
+        prefs.edit().putString(key, value).apply()
+    }
+
+    private fun toPreview(r: TmdbDiscoverResult, isTv: Boolean, imdb: String?, rating: String): MetaPreview {
+        val id = imdb ?: "tmdb:${r.id}"
+        val rawType = if (isTv) "series" else "movie"
+        kidsContentFilter.remember(id, rawType, rating)
+        val date = if (isTv) r.firstAirDate else r.releaseDate
+        return MetaPreview(
+            id = id,
+            type = if (isTv) ContentType.SERIES else ContentType.MOVIE,
+            rawType = rawType,
+            name = (if (isTv) r.name else r.title) ?: r.originalTitle ?: r.originalName ?: "",
+            poster = r.posterPath?.let { "https://image.tmdb.org/t/p/w500$it" },
+            posterShape = PosterShape.POSTER,
+            background = r.backdropPath?.let { "https://image.tmdb.org/t/p/w1280$it" },
+            logo = null,
+            description = r.overview?.takeIf { it.isNotBlank() },
+            releaseInfo = date?.take(4),
+            released = date?.takeIf { it.isNotBlank() },
+            imdbRating = r.voteAverage?.toFloat(),
+            voteCount = r.voteCount,
+            genres = emptyList(),
+            ageRating = rating,
+            imdbId = imdb
+        )
+    }
+}
diff --git a/app/src/main/java/com/nuvio/tv/core/kids/KidsContentFilter.kt b/app/src/main/java/com/nuvio/tv/core/kids/KidsContentFilter.kt
new file mode 100644
index 000000000..826a08d68
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/core/kids/KidsContentFilter.kt
@@ -0,0 +1,126 @@
+package com.nuvio.tv.core.kids
+
+import android.util.Log
+import com.nuvio.tv.BuildConfig
+import com.nuvio.tv.data.remote.api.TmdbApi
+import com.nuvio.tv.domain.model.MetaPreview
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.withTimeoutOrNull
+import java.util.concurrent.ConcurrentHashMap
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Forbidden Vid kids filter. On a kids profile only movies rated PG / PG-13
+ * and shows rated TV-Y, TV-Y7, TV-G or TV-PG are shown. Ratings come from the addon's
+ * own age rating when present, otherwise from TMDB (US certification).
+ * Anything that can't be rated is hidden.
+ */
+@Singleton
+class KidsContentFilter @Inject constructor(
+    @dagger.hilt.android.qualifiers.ApplicationContext context: android.content.Context,
+    private val kidsProfileStore: KidsProfileStore,
+    private val tmdbApi: TmdbApi
+) {
+    private val cache = ConcurrentHashMap<String, String>() // id -> rating ("" = unknown)
+    private val lookups = Semaphore(10)
+    // Ratings are remembered between launches so kids rows load fast after the first time.
+    private val saved = context.getSharedPreferences("fv_kids_ratings", android.content.Context.MODE_PRIVATE)
+
+    suspend fun isActive(): Boolean = kidsProfileStore.isKidsProfileActiveNow()
+
+    suspend fun filter(items: List<MetaPreview>): List<MetaPreview> {
+        if (items.isEmpty() || !isActive()) return items
+        return coroutineScope {
+            items.map { item ->
+                async { if (isRatingAllowed(item.id, item.rawType, item.ageRating, item.imdbId)) item else null }
+            }.awaitAll().filterNotNull()
+        }
+    }
+
+    suspend fun isAllowed(id: String, type: String, ageRating: String? = null, imdbId: String? = null): Boolean {
+        if (!isActive()) return true
+        return isRatingAllowed(id, type, ageRating, imdbId)
+    }
+
+    private suspend fun isRatingAllowed(id: String, type: String, ageRating: String?, imdbId: String?): Boolean {
+        val direct = ageRating?.let(::normalize)?.takeIf { it.isNotEmpty() }
+        val rating = direct ?: ratingFor(id, type, imdbId)
+        return rating in ALLOWED
+    }
+
+    /** Lets the kids catalogs share ratings they already verified, so detail pages open instantly. */
+    fun remember(id: String, type: String, rating: String) {
+        val cacheKey = "$type:$id"
+        val normalized = normalize(rating)
+        cache[cacheKey] = normalized
+        saved.edit().putString(cacheKey, normalized).apply()
+    }
+
+    private suspend fun ratingFor(id: String, type: String, imdbId: String?): String {
+        val cacheKey = "$type:$id"
+        cache[cacheKey]?.let { return it }
+        saved.getString(cacheKey, null)?.let { cache[cacheKey] = it; return it }
+        val key = BuildConfig.TMDB_API_KEY
+        if (key.isBlank()) return ""
+        val looked = lookups.withPermit {
+            withTimeoutOrNull(6_000) { lookupTmdb(id, type, imdbId, key) }
+        }
+        // Only remember real answers; a timeout or network error is retried next time.
+        if (looked == null) return ""
+        cache[cacheKey] = looked
+        saved.edit().putString(cacheKey, looked).apply()
+        return looked
+    }
+
+    private suspend fun lookupTmdb(id: String, type: String, imdbId: String?, key: String): String? {
+        return try {
+            val isTv = type == "series" || type == "tv"
+            val tmdbId: Int? = when {
+                id.startsWith("tmdb:") -> id.removePrefix("tmdb:").substringBefore(':').toIntOrNull()
+                else -> {
+                    val imdb = (imdbId ?: id).substringBefore(':').takeIf { it.startsWith("tt") } ?: return ""
+                    val found = tmdbApi.findByExternalId(imdb, key).body()
+                    if (isTv) found?.tvResults?.firstOrNull()?.id else found?.movieResults?.firstOrNull()?.id
+                }
+            }
+            if (tmdbId == null) return ""
+            if (isTv) {
+                val ratings = tmdbApi.getTvContentRatings(tmdbId, key).body()?.results.orEmpty()
+                normalize(ratings.firstOrNull { it.iso31661 == "US" }?.rating ?: "")
+            } else {
+                val countries = tmdbApi.getMovieReleaseDates(tmdbId, key).body()?.results.orEmpty()
+                val us = countries.firstOrNull { it.iso31661 == "US" }?.releaseDates.orEmpty()
+                normalize(us.mapNotNull { it.certification?.takeIf(String::isNotBlank) }.firstOrNull() ?: "")
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w("KidsContentFilter", "Rating lookup failed for $type $id: ${e.message}")
+            null
+        }
+    }
+
+    companion object {
+        // Movies: PG and PG-13. TV: TV-Y, TV-Y7, TV-G, TV-PG.
+        val ALLOWED = setOf("PG", "PG-13", "TV-Y", "TV-Y7", "TV-Y7-FV", "TV-G", "TV-PG")
+
+        fun normalize(raw: String): String {
+            val r = raw.trim().uppercase().replace(" ", "").replace("_", "-")
+            return when (r) {
+                "PG13" -> "PG-13"
+                "TVY" -> "TV-Y"
+                "TVY7" -> "TV-Y7"
+                "TVG" -> "TV-G"
+                "TVPG" -> "TV-PG"
+                "TV14" -> "TV-14"
+                else -> r
+            }
+        }
+    }
+}
