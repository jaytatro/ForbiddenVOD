+private const val KIDS_RATINGS_LINE = "Movies rated PG & PG-13 · Shows rated TV-Y, TV-Y7, TV-G & TV-PG"
+
+/**
+ * Forbidden Vid: on a kids profile, show [kidsContent]; otherwise [normalContent].
+ * Nothing is drawn until the saved profile is known, so grown-up rows never flash on screen.
+ */
+@Composable
+fun KidsGate(
+    kidsContent: @Composable () -> Unit,
+    normalContent: @Composable () -> Unit
+) {
+    val viewModel: KidsViewModel = hiltViewModel()
+    val isKids by viewModel.isKids.collectAsState()
+    val startupLoadingState = com.nuvio.tv.ui.components.LocalStartupLoadingState.current
+    // The normal Home screen ends the startup loading screen itself; the kids screens must do it too.
+    LaunchedEffect(isKids, startupLoadingState) {
+        if (isKids == true) startupLoadingState?.complete = true
+    }
+    when (isKids) {
+        null -> Box(Modifier.fillMaxSize().background(NuvioTheme.colors.Background))
+        true -> kidsContent()
+        false -> normalContent()
+    }
+}
+
+@Composable
+fun KidsHomeScreen(
+    onNavigateToDetail: (String, String) -> Unit,
+    viewModel: KidsViewModel = hiltViewModel()
+) {
+    val startupLoadingState = com.nuvio.tv.ui.components.LocalStartupLoadingState.current
+    LaunchedEffect(Unit) {
+        startupLoadingState?.complete = true
+        viewModel.loadHome()
+    }
+    val rows by viewModel.homeRows.collectAsState()
+
+    LazyColumn(
+        modifier = Modifier.fillMaxSize().background(NuvioTheme.colors.Background),
+        contentPadding = PaddingValues(start = 48.dp, top = 28.dp, bottom = 56.dp),
+        verticalArrangement = Arrangement.spacedBy(26.dp)
+    ) {
+        item(key = "header") { KidsHeader("Kids") }
+        if (!viewModel.hasRatingsSource) {
+            item(key = "nokey") { KidsMessage("Kids content needs a ratings source. Ask the app owner to add a TMDB key.") }
+        }
+        items(rows, key = { it.key }) { row ->
+            Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                Text(
+                    text = row.title,
+                    style = MaterialTheme.typography.titleLarge,
+                    color = NuvioTheme.colors.TextPrimary
+                )
+                if (row.items.isEmpty()) {
+                    Text(
+                        text = if (row.loading) "Loading…" else "Nothing here yet",
+                        style = MaterialTheme.typography.bodyMedium,
+                        color = NuvioTheme.colors.TextSecondary
+                    )
+                } else {
+                    LazyRow(
+                        horizontalArrangement = Arrangement.spacedBy(16.dp),
+                        contentPadding = PaddingValues(end = 48.dp, top = 6.dp, bottom = 6.dp)
+                    ) {
+                        items(row.items, key = { it.id }) { item ->
+                            ContentCard(
+                                item = item,
+                                onClick = { onNavigateToDetail(item.id, item.rawType) }
+                            )
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+fun KidsBrowseScreen(
+    type: String,
+    title: String,
+    onNavigateToDetail: (String, String) -> Unit,
+    viewModel: KidsViewModel = hiltViewModel()
+) {
+    val genres = if (type == "movie") KidsViewModel.MOVIE_GENRES else KidsViewModel.TV_GENRES
+    val state by viewModel.browse.collectAsState()
+    LaunchedEffect(type) { viewModel.startBrowse(type, state.genre) }
+
+    LazyVerticalGrid(
+        columns = GridCells.Adaptive(minSize = 150.dp),
+        modifier = Modifier.fillMaxSize().background(NuvioTheme.colors.Background),
+        contentPadding = PaddingValues(start = 48.dp, end = 48.dp, top = 28.dp, bottom = 56.dp),
+        horizontalArrangement = Arrangement.spacedBy(16.dp),
+        verticalArrangement = Arrangement.spacedBy(20.dp)
+    ) {
+        item(span = { GridItemSpan(maxLineSpan) }, key = "header") { KidsHeader(title) }
+        item(span = { GridItemSpan(maxLineSpan) }, key = "genres") {
+            LazyRow(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                items(genres, key = { it.label }) { genre ->
+                    val selected = genre.id == state.genre
+                    Button(
+                        onClick = { viewModel.startBrowse(type, genre.id) },
+                        colors = ButtonDefaults.colors(
+                            containerColor = if (selected) NuvioTheme.colors.Secondary else NuvioTheme.colors.BackgroundCard,
+                            contentColor = if (selected) NuvioTheme.colors.OnSecondary else NuvioTheme.colors.TextPrimary,
+                            focusedContainerColor = NuvioTheme.colors.SecondaryVariant,
+                            focusedContentColor = NuvioTheme.colors.OnSecondaryVariant
+                        ),
+                        shape = ButtonDefaults.shape(RoundedCornerShape(50))
+                    ) { Text(genre.label) }
+                }
+            }
+        }
+        if (!viewModel.hasRatingsSource) {
+            item(span = { GridItemSpan(maxLineSpan) }, key = "nokey") {
+                KidsMessage("Kids content needs a ratings source. Ask the app owner to add a TMDB key.")
+            }
+        }
+        items(state.items, key = { it.id }) { item ->
+            ContentCard(item = item, onClick = { onNavigateToDetail(item.id, item.rawType) })
+        }
+        item(span = { GridItemSpan(maxLineSpan) }, key = "more") {
+            Box(Modifier.fillMaxWidth().padding(top = 8.dp), contentAlignment = Alignment.Center) {
+                when {
+                    state.loading -> KidsMessage("Loading…")
+                    state.items.isEmpty() -> KidsMessage("Nothing here yet")
+                    state.canLoadMore -> Button(
+                        onClick = { viewModel.loadMore() },
+                        colors = ButtonDefaults.colors(
+                            containerColor = NuvioTheme.colors.BackgroundCard,
+                            contentColor = NuvioTheme.colors.TextPrimary,
+                            focusedContainerColor = NuvioTheme.colors.Secondary,
+                            focusedContentColor = NuvioTheme.colors.OnSecondary
+                        ),
+                        shape = ButtonDefaults.shape(RoundedCornerShape(50))
+                    ) { Text("Load more") }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun KidsHeader(title: String) {
+    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+        Text(text = title, style = MaterialTheme.typography.headlineMedium, color = NuvioTheme.colors.TextPrimary)
+        Text(text = KIDS_RATINGS_LINE, style = MaterialTheme.typography.bodyMedium, color = NuvioTheme.colors.Secondary)
+    }
+}
+
+@Composable
+private fun KidsMessage(text: String) {
+    Row { Text(text = text, style = MaterialTheme.typography.bodyLarge, color = NuvioTheme.colors.TextSecondary) }
+}
