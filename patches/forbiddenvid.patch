@@ -0,0 +1,69 @@
+package com.nuvio.tv.core.kids
+
+import android.content.Context
+import androidx.datastore.core.DataStore
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.stringSetPreferencesKey
+import androidx.datastore.preferences.preferencesDataStoreFile
+import com.nuvio.tv.core.profile.ProfileManager
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.stateIn
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Forbidden Vid: remembers which profiles are kids profiles (stored on this device).
+ * The primary profile can never be a kids profile.
+ */
+@Singleton
+class KidsProfileStore @Inject constructor(
+    @ApplicationContext context: Context,
+    profileManager: ProfileManager,
+    private val profileDataStore: com.nuvio.tv.data.local.ProfileDataStore
+) {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val key = stringSetPreferencesKey("kids_profile_ids")
+    private val store: DataStore<Preferences> = PreferenceDataStoreFactory.create(
+        scope = scope,
+        produceFile = { context.preferencesDataStoreFile("fv_kids_profiles") }
+    )
+
+    val kidsProfileIds: StateFlow<Set<Int>> = store.data
+        .map { prefs -> prefs[key].orEmpty().mapNotNull { it.toIntOrNull() }.filter { it != 1 }.toSet() }
+        .stateIn(scope, SharingStarted.Eagerly, emptySet())
+
+    val isKidsProfileActive: StateFlow<Boolean> = combine(kidsProfileIds, profileManager.activeProfileId) { ids, active ->
+        active in ids
+    }.stateIn(scope, SharingStarted.Eagerly, false)
+
+    fun isKids(profileId: Int): Boolean = profileId in kidsProfileIds.value
+
+    /** Reads the saved active profile and kids list from storage, so it's right even during startup or a switch. */
+    suspend fun isKidsProfileActiveNow(): Boolean {
+        val ids = store.data.first()[key].orEmpty().mapNotNull { it.toIntOrNull() }.filter { it != 1 }.toSet()
+        if (ids.isEmpty()) return false
+        return profileDataStore.activeProfileId.first() in ids
+    }
+
+    suspend fun isKidsNow(profileId: Int): Boolean =
+        profileId != 1 && store.data.first()[key].orEmpty().contains(profileId.toString())
+
+    suspend fun setKids(profileId: Int, kids: Boolean) {
+        if (profileId == 1) return
+        store.edit { prefs ->
+            val current = prefs[key].orEmpty().toMutableSet()
+            if (kids) current.add(profileId.toString()) else current.remove(profileId.toString())
+            prefs[key] = current
+        }
+    }
+}
